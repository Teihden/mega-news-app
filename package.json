{
  "name": "mega-news-app",
  "version": "1.0.0",
  "description": "Mega News is a modern platform with up—to-date news, analytics, and personalized recommendations",
  "main": "",
  "type": "module",
  "homepage": "",
  "author": "Teihden",
  "private": true,
  "license": "ISC",
  "sideEffects": false,
  "scripts": {
    "start": "dotenv -e .env -- cross-env vite dev",
    "build": "tsc -b && vite build",
    "preview": "dotenv -e .env -- cross-env vite preview",
    "lint": "npm run stylelint && npm run eslint",
    "stylelint": "stylelint --config stylelint.config.mjs ./src --fix",
    "eslint": "eslint --no-config-lookup --config eslint.config.ts ./src --fix",
    "eslint-config-inspect": "npx @eslint/config-inspector --config eslint.config.ts",
    "check-deps-updates": "npx npm-check-updates",
    "update-deps": "npx npm-check-updates -u && npm i --force",
    "prepare": "cd ./ && husky ./.husky",
    "postinstall": "npx msw init"
  },
  "imports": {
    "@public/*": "./public/*",
    "@app/*": "./src/app/*",
    "@entities/*": "./src/entities/*",
    "@features/*": "./src/features/*",
    "@pages/*": "./src/pages/*",
    "@shared/*": "./src/shared/*",
    "@widgets/*": "./src/widgets/*"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/config-inspector": "^1.4.2",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.0.1",
    "@eslint/markdown": "^7.5.1",
    "@redux-devtools/extension": "^3.3.0",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@stylistic/stylelint-config": "^4.0.0",
    "@stylistic/stylelint-plugin": "^5.0.1",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/eslint": "^9.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/espree": "^11.1.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.36",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-plugin-styled-components": "^2.1.4",
    "browserslist": "^4.28.1",
    "commitlint": "^20.4.2",
    "create-vite": "^8.3.0",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv-cli": "^11.0.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.7.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-security": "^4.0.0",
    "espree": "^11.1.1",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lightningcss": "^1.31.1",
    "msw": "^2.12.10",
    "npm-check-updates": "^19.4.1",
    "postcss-styled-syntax": "^0.7.1",
    "react-content-loader": "^7.1.2",
    "rimraf": "^6.1.3",
    "sharp": "^0.34.5",
    "stylelint": "^17.3.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^7.0.1",
    "svgo": "^4.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-bundle-analyzer": "^1.3.6",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-compression2": "^2.4.0",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-inspect": "^11.3.3",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-svgr": "^4.5.0"
  },
  "dependencies": {
    "@bedrock-layout/css": "^3.0.1",
    "@bedrock-layout/primitives": "^4.0.1",
    "@ramonak/react-progress-bar": "^5.4.0",
    "@reduxjs/toolkit": "^2.11.2",
    "clsx": "^2.1.1",
    "formik": "^2.4.9",
    "js-cookie": "^3.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "react-hot-toast": "^2.6.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.13.1",
    "react-tooltip": "^5.30.0",
    "remeda": "^2.33.6",
    "styled-breakpoints": "^14.2.0",
    "styled-components": "^6.3.11",
    "swiper": "^12.1.2",
    "yup": "^1.7.1",
    "zustand": "^5.0.11"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "browserslist": [
    ">= 0.25%",
    "defaults"
  ],
  "overrides": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
