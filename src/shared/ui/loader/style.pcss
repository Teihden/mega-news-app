.loader {
  @mixin transition .2s;
  @mixin hide;
  --loaderPosition: fixed;
  --loaderInset: 0;
  --loaderDisplay: flex;
  --loaderFlexFlow: column;
  --loaderAlignItems: center;
  --loaderGap: 5rem;
  --loaderFontSize: 2.125rem;
  --loaderZIndex: var(--loaderIndexZ);
  --loaderTextAlign: center;
  --loaderCursor: wait;
  --loaderBackground: var(--colorBlackA50);
  --loaderPlaceContent: center;
  --loaderTransform: 0;
  --loaderBorderRadius: 0;
  --loaderColor: var(--colorWhite);
  inset: var(--loaderInset);
  display: var(--loaderDisplay);
  flex-flow: var(--loaderFlexFlow);
  align-items: var(--loaderAlignItems);
  gap: var(--loaderGap);
  font-size: var(--loaderFontSize);
  z-index: var(--loaderZIndex);
  text-align: var(--loaderTextAlign);
  position: var(--loaderPosition);
  transform: var(--loaderTransform);
  cursor: var(--loaderCursor);
  place-content: var(--loaderPlaceContent);
  background: var(--loaderBackground);
  border-radius: var(--loaderBorderRadius);
  color: var(--loaderColor);
  
  && {
    display: var(--loaderDisplay);
  }
  
  &.isShow {
    @mixin show;
  }
  
  &__wrapper {
    position: relative;
  }
  
  &__whirlpool {
    position: absolute;
    inset: 50% auto auto 50%;
    border: 1px solid var(--colorWhite);
    border-left-color: var(--colorBlack);
    border-radius: 50%;
    margin: -3rem 0 0 -3rem;
    height: 6.125rem;
    width: 6.125rem;
    animation: rotate 1150ms linear infinite;
    
    &::before {
      content: "";
      position: absolute;
      inset: 50% auto auto 50%;
      border: 1px solid var(--colorWhite);
      border-left-color: var(--colorBlack);
      border-radius: 50%;
      margin: -2.75rem 0 0 -2.75rem;
      height: 5.375rem;
      width: 5.375rem;
      animation: rotate 1150ms linear infinite;
    }
    
    &::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      border: 1px solid var(--colorWhite);
      border-left-color: var(--colorBlack);
      border-radius: 50%;
      margin: -3.5rem 0 0 -3.5rem;
      height: 6.875rem;
      width: 6.875rem;
      animation: rotate 2300ms linear infinite;
    }
  }
}

@keyframes rotate {
  100% {
    transform: rotate(360deg);
  }
  
  0% {
    transform: rotate(0deg);
  }
}
